<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

        <!-- ============ CARTÃO (FRENTE / VERSO) ============ -->
        <ViewFlipper
            android:id="@+id/cardFlipper"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- FRENTE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#101A2C">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <!-- Logo da bandeira (texto trocado dinamicamente no Kotlin) -->
                    <TextView
                        android:id="@+id/tvBrandLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARTÃO"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Chip -->
                    <View
                        android:id="@+id/viewChip"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:background="#D4AF37"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBrandLogo"
                        android:layout_marginTop="16dp" />

                    <!-- Número do cartão -->
                    <TextView
                        android:id="@+id/tvCardNumberDisplay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="•••• •••• •••• ••••"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:letterSpacing="0.05"
                        android:fontFamily="monospace"
                        app:layout_constraintTop_toBottomOf="@id/viewChip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Nome do titular -->
                    <TextView
                        android:id="@+id/tvHolderDisplay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="NOME DO TITULAR"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvValidityDisplay" />

                    <!-- Validade -->
                    <TextView
                        android:id="@+id/tvValidityDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MM/AA"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- VERSO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#101A2C">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Tarja magnética -->
                    <View
                        android:id="@+id/viewMagneticStripe"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:background="#000000"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Faixa de assinatura + CVV -->
                    <View
                        android:id="@+id/viewSignatureStrip"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="20dp"
                        android:background="#FFFFFF"
                        app:layout_constraintTop_toBottomOf="@id/viewMagneticStripe"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvCvvDisplay" />

                    <TextView
                        android:id="@+id/tvCvvDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="#FFFFFF"
                        android:text="•••"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@id/viewMagneticStripe"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </ViewFlipper>

        <!-- ============ FORMULÁRIO ============ -->

        <EditText
            android:id="@+id/etCardNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="20dp"
            android:hint="Número do cartão"
            android:inputType="number"
            android:maxLength="19"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/cardFlipper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etHolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            android:hint="Nome do titular"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/etCardNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etValidity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:hint="MM/AA"
            android:inputType="number"
            android:maxLength="5"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/etHolder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etCvv"
            app:layout_constraintWidth_percent="0.45" />

        <EditText
            android:id="@+id/etCvv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:hint="CVV"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/etHolder"
            app:layout_constraintStart_toEndOf="@id/etValidity"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="20dp"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Número do cartão inválido"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/etValidity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:text="Confirmar"
            app:layout_constraintTop_toBottomOf="@id/tvErrorMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>